generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  BONUS_SELF
  MALUS_OTHER
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
}

model Team {
  id          String   @id @default(cuid())
  slug        String   @unique
  // "pin" est VOLONTAIREMENT en clair (pas de hash) : les organisateurs
  // doivent pouvoir le retrouver à tout moment pour le recommuniquer à une
  // équipe qui l'a perdu. Enjeu faible (pas de données sensibles derrière),
  // décision explicite du comité — voir AGENTS.md.
  pin          String   @unique
  unitName     String   @default("")
  sectionName  String   @default("")
  foulardName  String   @default("")
  foulardColor String   @default("#e10600")
  foulardEmoji String   @default("🏁")
  createdAt    DateTime @default(now())

  dossards           Dossard[]
  pointsTransactions PointsTransaction[]
  purchasesMade      Purchase[]
}

// Un vélo = un dossard. Une équipe (écurie) peut avoir plusieurs vélos
// (plusieurs dossards) — d'où une table séparée plutôt qu'un champ unique sur
// Team. Le classement course se fait PAR VÉLO ; les points sont PAR ÉCURIE.
model Dossard {
  id        String   @id @default(cuid())
  number    Int      @unique
  // Surnom du vélo, personnalisable par l'écurie (vide = "Vélo #n").
  name      String   @default("")
  teamId    String?
  createdAt DateTime @default(now())

  team              Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  adjustments       RaceAdjustment[]
  purchasesTargeted Purchase[]
}

model Organizer {
  id          String   @id @default(cuid())
  displayName String
  pinHash     String
  createdAt   DateTime @default(now())

  pointsTransactions PointsTransaction[]
}

model PointsTransaction {
  id          String    @id @default(cuid())
  teamId      String
  organizerId String?
  points      Int
  reason      String
  performedBy String    @default("")
  // Annulation = soft delete (on garde la trace pour l'audit), exclue des soldes.
  cancelledAt DateTime?
  cancelledBy String?
  createdAt   DateTime  @default(now())

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizer Organizer? @relation(fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

model MarketplaceItem {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  costPoints  Int
  type        ItemType
  // Toujours signé selon le type : BONUS_SELF > 0, MALUS_OTHER < 0 (forcé par l'API).
  lapEffect   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases Purchase[]
}

// Achat bonus/malus. Ce sont les ORGANISATEURS (direction de course) qui
// dépensent les points d'une écurie à sa demande — plus d'achat en
// self-service par l'équipe. Cible = un VÉLO précis (dossard).
model Purchase {
  id              String    @id @default(cuid())
  buyingTeamId    String
  targetDossardId String
  itemId          String?
  // Snapshot de l'item au moment de l'achat (le catalogue peut changer ensuite).
  itemName        String
  type            ItemType
  costPoints      Int
  lapDelta        Int
  performedBy     String    @default("")
  cancelledAt     DateTime?
  cancelledBy     String?
  createdAt       DateTime  @default(now())

  buyingTeam    Team             @relation(fields: [buyingTeamId], references: [id], onDelete: Cascade)
  targetDossard Dossard          @relation(fields: [targetDossardId], references: [id], onDelete: Cascade)
  item          MarketplaceItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  adjustment    RaceAdjustment?

  @@index([buyingTeamId])
  @@index([targetDossardId])
}

// Un passage sur la ligne (un tour). Source = 'raceresult-push',
// 'raceresult-poll', 'manual', 'mock'... Le classement compte TOUS les
// passages d'un dossard, quelle que soit la source.
model RaceLapEvent {
  id            String   @id @default(cuid())
  dossardNumber Int
  timestamp     DateTime
  source        String
  // Identifiant fourni par le chrono (ou bib@heure) — dédoublonnage des renvois.
  externalId    String?  @unique
  rawPayload    Json?
  createdAt     DateTime @default(now())

  @@index([dossardNumber])
  @@index([createdAt])
}

// Ajustement de tours sur un vélo : achat bonus/malus ou correction comité.
model RaceAdjustment {
  id          String   @id @default(cuid())
  dossardId   String
  lapDelta    Int
  source      String   // 'purchase' | 'correction'
  reason      String   @default("")
  performedBy String   @default("")
  purchaseId  String?  @unique
  createdAt   DateTime @default(now())

  dossard  Dossard   @relation(fields: [dossardId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([dossardId])
}

// Réglages modifiables à chaud depuis l'admin (chrono, horloge de course),
// lus aussi par le daemon de chronométrage — pas besoin de redéployer.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
